# Explicit local/demo or production mode. Package scripts set this automatically.
VITE_APP_MODE=
# Production requires one HTTPS origin without a trailing slash.
VITE_API_BASE_URL=
# Platform AppIDs are injected only into isolated build inputs.
WECHAT_MINIAPP_APP_ID=
DOUYIN_MINIAPP_APP_ID=
# Optional approved Douyin native-share template. WeChat does not use it.
DOUYIN_CO_LISTEN_SHARE_TEMPLATE_ID=
